# Optional for local development against Azure Storage. No secrets are required.
AZURE_STORAGE_BLOB_URL=https://example.blob.core.windows.net
AZURE_STORAGE_TABLE_URL=https://example.table.core.windows.net
AZURE_STORAGE_BLOB_CONTAINER=images
AZURE_STORAGE_TABLE_NAME=posts

# Optional author configuration JSON. Empty disables login; never commit a value.
# Use scripts.create_author_config to generate password hashes and a session secret.
AUTHOR_CONFIG=
